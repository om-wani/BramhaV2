# Database — leave unset locally to use PGlite (embedded, zero-install)
# DATABASE_URL=postgres://user:pass@host:5432/bramha

# LLM providers
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Optional: OpenAI-compatible gateway for CHAT (e.g. OpenRouter).
# When using an OpenRouter key (sk-or-...), also set the base URL + a
# provider-prefixed chat model:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Free models (no credits): OPENAI_CHAT_MODEL=google/gemma-4-31b-it:free
#   OPENAI_CHAT_MODEL_LIGHT=google/gemma-4-26b-a4b-it:free
# Paid (better): OPENAI_CHAT_MODEL=moonshotai/kimi-k2.6
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=
# OPENAI_CHAT_MODEL_LIGHT=
# Optional self-hosted SearXNG for web search (else DuckDuckGo fallback):
# SEARXNG_URL=https://your-searxng.onrender.com

# Embeddings (RAG + relevance) default to OPENAI_API_KEY + OPENAI_BASE_URL.
# Override only to run embeddings on a different provider than chat:
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# Auth
SESSION_SECRET=change_me_32_plus_chars_random

# Server
APP_ORIGIN=http://localhost:3000
UPLOADS_DIR=./uploads
NODE_ENV=development

# Ports
PORT_SERVER=3001
PORT_WEB=3000

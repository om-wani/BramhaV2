# Database
DATABASE_URL=postgresql://bramha_dev:dev_only_postgres_password@localhost:5432/bramha_dev

# Redis
REDIS_URL=redis://:dev_only_redis_password@localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev_only_minio_root
S3_SECRET_KEY=dev_only_minio_password
S3_BUCKET_STAGING=bramha-staging
S3_BUCKET_CLEAN=bramha-clean
S3_BUCKET_QUARANTINE=bramha-quarantine
S3_BUCKET_ARTIFACTS=bramha-artifacts

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# OpenTelemetry
OTEL_ENDPOINT=http://localhost:4318

# App
NODE_ENV=development
PORT=3000
API_PORT=4000

# Auth (CHANGE THESE — scripts/bootstrap.sh generates real values into apps/api/.env)
# JWT_SECRET: openssl rand -hex 32
# MASTER_KEY: openssl rand -base64 32 (must decode to exactly 32 bytes)
# JWT keypair: openssl genpkey -algorithm ed25519 | base64 -w0 (PKCS8 private, SPKI public)
JWT_SECRET=dev_only_jwt_secret_change_in_production
MASTER_KEY=dev_only_master_key_must_be_32bytes_!
JWT_PRIVATE_KEY_BASE64=generate_with_bootstrap_sh
JWT_PUBLIC_KEY_BASE64=generate_with_bootstrap_sh

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Terraform state — never commit
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Plan files
*.tfplan
*.plan

# Sensitive var overrides
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log
crash.log
crash.*.log

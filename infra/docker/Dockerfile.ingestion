# Dockerfile.ingestion — BullMQ file/source ingestion worker
# Multi-stage: build stage compiles TypeScript, runtime stage runs compiled JS.
# Includes ClamAV for virus scanning of uploaded files.

# ── Build stage ───────────────────────────────────────────────────────────────

FROM node:22-alpine AS build

WORKDIR /build

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# sharp requires platform-specific native modules — build on the target platform
# Install build tools for native modules
RUN apk add --no-cache python3 make g++

# Copy workspace manifests for dependency resolution
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/ingestion-worker/package.json ./apps/ingestion-worker/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/agents/package.json ./packages/agents/
COPY packages/event-bus/package.json ./packages/event-bus/

# Install all deps (including dev) for build
RUN pnpm install \
    --filter @bramha/ingestion-worker \
    --filter @bramha/shared \
    --filter @bramha/db \
    --filter @bramha/agents \
    --filter @bramha/event-bus \
    --frozen-lockfile

# Copy source
COPY tsconfig.base.json ./
COPY packages/shared/src ./packages/shared/src
COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/db/src ./packages/db/src
COPY packages/db/tsconfig.json ./packages/db/
COPY packages/agents/src ./packages/agents/src
COPY packages/agents/tsconfig.json ./packages/agents/
COPY packages/event-bus/src ./packages/event-bus/src
COPY packages/event-bus/tsconfig.json ./packages/event-bus/
COPY apps/ingestion-worker/src ./apps/ingestion-worker/src
COPY apps/ingestion-worker/tsconfig.json ./apps/ingestion-worker/

# Build all packages in dependency order
RUN pnpm --filter @bramha/shared build && \
    pnpm --filter @bramha/db build && \
    pnpm --filter @bramha/agents build && \
    pnpm --filter @bramha/event-bus build && \
    pnpm --filter @bramha/ingestion-worker build

# ── Runtime stage ─────────────────────────────────────────────────────────────

FROM node:22-alpine AS runtime

# dumb-init as PID 1 — proper signal handling
# clamav for virus scanning, clamav-daemon for clamd process
# NOTE: build tools (python3, make, g++) stay in the build stage only;
# compiled .node binaries are copied from there — no toolchain in the runtime image.
RUN apk add --no-cache dumb-init clamav clamav-daemon

# Update ClamAV virus definitions
RUN freshclam --quiet || true

# Non-root user
RUN addgroup -S ingestion && adduser -S ingestion -G ingestion

WORKDIR /app

# Copy compiled output and production node_modules (with native .node binaries) from build
COPY --from=build /build/apps/ingestion-worker/dist ./dist
COPY --from=build /build/apps/ingestion-worker/package.json ./package.json
COPY --from=build /build/node_modules ./node_modules

# Copy compiled workspace packages
COPY --from=build /build/packages/shared/dist ./node_modules/@bramha/shared/dist
COPY --from=build /build/packages/shared/package.json ./node_modules/@bramha/shared/package.json
COPY --from=build /build/packages/db/dist ./node_modules/@bramha/db/dist
COPY --from=build /build/packages/db/package.json ./node_modules/@bramha/db/package.json
COPY --from=build /build/packages/agents/dist ./node_modules/@bramha/agents/dist
COPY --from=build /build/packages/agents/package.json ./node_modules/@bramha/agents/package.json
COPY --from=build /build/packages/event-bus/dist ./node_modules/@bramha/event-bus/dist
COPY --from=build /build/packages/event-bus/package.json ./node_modules/@bramha/event-bus/package.json

USER ingestion

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD node -e "require('./dist/check-env.js')" || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]

# Dockerfile.api — NestJS + Fastify backend
# Multi-stage: build stage compiles TypeScript, runtime stage runs compiled JS.

# ── Build stage ───────────────────────────────────────────────────────────────

FROM node:22-alpine AS build

WORKDIR /build

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# pnpm v9+ requires ALL workspace package.json files present to resolve the
# lockfile, even when using --filter. Copy all manifests first for layer caching.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/agent-runtime/package.json ./apps/agent-runtime/
COPY apps/ingestion-worker/package.json ./apps/ingestion-worker/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/agents/package.json ./packages/agents/
COPY packages/event-bus/package.json ./packages/event-bus/
COPY packages/mcp-connectors/package.json ./packages/mcp-connectors/
COPY infra/sandbox/package.json ./infra/sandbox/

# Install all deps (including dev) for build
RUN pnpm install \
    --filter @bramha/api \
    --filter @bramha/shared \
    --filter @bramha/db \
    --filter @bramha/agents \
    --filter @bramha/event-bus \
    --filter @bramha/mcp-connectors \
    --frozen-lockfile

# Copy source
COPY tsconfig.base.json ./
COPY packages/shared/src ./packages/shared/src
COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/db/src ./packages/db/src
COPY packages/db/tsconfig.json ./packages/db/
COPY packages/agents/src ./packages/agents/src
COPY packages/agents/tsconfig.json ./packages/agents/
COPY packages/event-bus/src ./packages/event-bus/src
COPY packages/event-bus/tsconfig.json ./packages/event-bus/
COPY packages/mcp-connectors/src ./packages/mcp-connectors/src
COPY packages/mcp-connectors/tsconfig.json ./packages/mcp-connectors/
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/

# Build all packages in dependency order
RUN pnpm --filter @bramha/shared build && \
    pnpm --filter @bramha/db build && \
    pnpm --filter @bramha/agents build && \
    pnpm --filter @bramha/event-bus build && \
    pnpm --filter @bramha/mcp-connectors build && \
    pnpm --filter @bramha/api build

# pnpm deploy resolves workspace:* deps (shared/db/agents/event-bus/mcp-connectors)
# to real packages, prod only. --legacy: pnpm v10+ otherwise requires
# inject-workspace-packages=true.
RUN pnpm --filter @bramha/api deploy --prod --legacy /build/deploy

# ── Runtime stage ─────────────────────────────────────────────────────────────

FROM node:22-alpine AS runtime

# dumb-init as PID 1 — proper signal handling
RUN apk add --no-cache dumb-init

# Non-root user
RUN addgroup -S api && adduser -S api -G api

WORKDIR /app

# Copy pnpm deploy output: node_modules (workspace:* resolved), package.json, dist
COPY --from=build /build/deploy ./

ENV PORT=4000
EXPOSE 4000

USER api

# 127.0.0.1, not localhost: Alpine's musl resolver prefers ::1, and the app
# only binds IPv4 (0.0.0.0) — "localhost" here would always connection-refuse.
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:4000/health/live || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]

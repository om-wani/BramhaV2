# Dockerfile.sandbox-executor — minimal Python + Node runtime for run_code tool
#
# Security model (enforced by sandbox host, not this image):
#   --network none        no network access
#   --read-only           read-only rootfs
#   --tmpfs /workspace    ephemeral writable scratch space (32 MB)
#   --memory 512m         memory cap
#   --cpus 0.5            CPU cap
#   --security-opt seccomp=<profile>  strict syscall allowlist
#   --stop-timeout 5      5s grace period before SIGKILL
#
# Container is destroyed after every run (never reused).

FROM python:3.12-slim AS base

# Install Node.js for JS execution
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

# Non-root execution user
RUN groupadd -r sandbox && useradd -r -g sandbox -d /workspace -s /sbin/nologin sandbox

# Writable workspace is mounted as tmpfs by host — create mountpoint
RUN mkdir -p /workspace && chown sandbox:sandbox /workspace

WORKDIR /workspace

USER sandbox

# No CMD — the host passes the script via args
# No EXPOSE — no network access permitted

# Dockerfile.sandbox-host — HTTP service that manages ephemeral sandbox containers
# Build context is the repo root (referenced from compose.prod-sim.yml).

# ── Build stage ───────────────────────────────────────────────────────────────

FROM node:22-alpine AS build

WORKDIR /build

# Install TypeScript compiler
RUN npm install -g typescript tsx

COPY infra/sandbox/package.json ./
RUN npm install

COPY tsconfig.base.json ./
COPY infra/sandbox/tsconfig.json ./tsconfig.json
COPY infra/sandbox/src ./src

RUN tsc

# ── Runtime stage ─────────────────────────────────────────────────────────────

FROM node:22-alpine AS runtime

# dumb-init as PID 1 — proper signal handling
# docker-cli for spawning sandbox containers
RUN apk add --no-cache dumb-init docker-cli

# Non-root user; must be able to access Docker socket
RUN addgroup -S sandboxhost && adduser -S sandboxhost -G sandboxhost

WORKDIR /app

COPY --from=build /build/dist ./dist

EXPOSE 4200

USER sandboxhost

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:4200/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/sandbox-host.js"]
